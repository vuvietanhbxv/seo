CLAUDE_GATEWAY_BASE_URL=https://1gw.gwai.cloud
CLAUDE_GATEWAY_AUTH_HEADER=x-api-key
CLAUDE_API_KEY=your-claude-gateway-key
CLAUDE_MODEL=claude-3-5-sonnet
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001

# Optional image provider for Cong cu -> Viet bai.
# ARTICLE_IMAGE_PROVIDER=google-ai
# ARTICLE_IMAGE_PROVIDER=vertex-ai

# Optional Vertex AI fallback config. You can also set these directly in the UI.
# VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
# VERTEX_AI_REGION=us-central1
# VERTEX_AI_IMAGE_MODEL=imagen-4.0-fast-generate-001
# VERTEX_AI_CREDENTIALS_PATH=/absolute/path/to/credentials.json

# Optional: default is SEO_OPS_DB_DIR/tools.
# SEO_OPS_TOOL_OUTPUT_DIR=/mnt/data_web/cuahangphaohoa.shop/seo-ops-storage/tools
