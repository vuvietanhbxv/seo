NODE_ENV=production
HOST=127.0.0.1
PORT=3000
SEO_OPS_BASE_PATH=/

CLAUDE_GATEWAY_BASE_URL=https://1gw.gwai.cloud
CLAUDE_GATEWAY_AUTH_HEADER=x-api-key
CLAUDE_API_KEY=your-claude-gateway-key
CLAUDE_MODEL=claude-3-5-sonnet
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001

# CloudPanel Node.js Site storage. Keep production data outside the Git checkout.
SEO_OPS_STORAGE_DRIVER=json
SEO_OPS_DB_DIR=/home/seoops/seo-ops-storage
SEO_OPS_ENTITY_GUIDE_DIR=/home/seoops/seo-ops-storage/Entity Guide
SEO_OPS_TOOL_OUTPUT_DIR=/home/seoops/seo-ops-storage/tools
SEO_OPS_DB_BACKUPS=50

# Optional API/MCP protection.
# SEO_OPS_API_TOKEN=change-me
# SEO_OPS_MCP_TOKEN=change-me
# SEO_OPS_MCP_CONNECTOR_KEY=change-me

# Optional OpenSEO bridge. Keep OpenSEO behind localhost/private proxy.
# OPEN_SEO_BASE_URL=http://127.0.0.1:3001
# OPEN_SEO_MCP_URL=http://127.0.0.1:3001/mcp
# OPEN_SEO_MCP_TOKEN=
# OPEN_SEO_MCP_CONNECTOR_KEY=
# OPEN_SEO_TIMEOUT_MS=8000
# OpenSEO GSC OAuth is configured in the OpenSEO app env, not SEO Ops:
# GOOGLE_CLIENT_ID=your-open-seo-google-client-id
# GOOGLE_CLIENT_SECRET=your-open-seo-google-client-secret
# BETTER_AUTH_SECRET=long-random-secret

# Optional Google OAuth redirect for seoops.sumu.id.vn.
# SEO_OPS_GOOGLE_CLIENT_ID=your-google-client-id
# SEO_OPS_GOOGLE_CLIENT_SECRET=your-google-client-secret
# SEO_OPS_GOOGLE_REDIRECT_URI=https://seoops.sumu.id.vn/api/google/oauth/callback
# SEO_OPS_GOOGLE_TOKEN_SECRET=long-random-secret

# Optional MariaDB/MySQL driver. Enable after running migration and verify.
# SEO_OPS_STORAGE_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=seoops_db
# DB_USERNAME=seoops_user
# DB_PASSWORD=change-me
# DB_SSL=false

# Optional image provider for Cong cu -> Viet bai.
# ARTICLE_IMAGE_PROVIDER=google-ai
# ARTICLE_IMAGE_PROVIDER=vertex-ai

# Optional Vertex AI fallback config. You can also set these directly in the UI.
# VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
# VERTEX_AI_REGION=us-central1
# VERTEX_AI_IMAGE_MODEL=imagen-4.0-fast-generate-001
# VERTEX_AI_CREDENTIALS_PATH=/absolute/path/to/credentials.json

# Optional: default output dir is SEO_OPS_DB_DIR/tools.
