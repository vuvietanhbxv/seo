{
  "name": "new-project-8",
  "private": true,
  "version": "2.0.0",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:seo-domain": "node -e \"process.env.VITE_BASE_PATH='/'; require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "build:seo-ops": "node -e \"process.env.VITE_BASE_PATH='/seo-ops/'; require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "seed:clean": "node scripts/create-clean-seed.cjs",
    "publish:plesk": "npm run seed:clean && npm run build:seo-domain && node scripts/publish-plesk.cjs",
    "publish:cloudpanel": "npm run seed:clean && npm run build:seo-domain && node scripts/publish-cloudpanel.cjs",
    "cloudpanel:deploy": "bash deploy/cloudpanel/deploy.sh",
    "cloudpanel:update": "bash deploy/cloudpanel/update.sh",
    "pm2:start": "pm2 startOrRestart ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart seoops --update-env",
    "pm2:logs": "pm2 logs seoops",
    "db:mysql:migrate": "node scripts/migrate-json-to-mariadb.cjs",
    "db:mysql:export": "node scripts/export-mariadb-to-json.cjs",
    "db:mysql:verify": "node scripts/verify-mariadb-storage.cjs",
    "open-seo:install": "cd open-seo && pnpm install --frozen-lockfile",
    "open-seo:migrate": "cd open-seo && pnpm run db:migrate:local",
    "open-seo:dev": "cd open-seo && pnpm exec vite dev --host 127.0.0.1 --strictPort",
    "open-seo:build": "cd open-seo && pnpm run build",
    "open-seo:preview": "cd open-seo && pnpm exec vite preview --host 127.0.0.1 --port 3001 --strictPort",
    "start": "node app.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "google-auth-library": "^10.6.2",
    "mysql2": "^3.22.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
